{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "NETFace-Super-Secret-Key-Must-Be-At-Least-32-Bytes-Long-123456",
    "Issuer": "NETFace.Attendance.Api",
    "Audience": "NETFace.Attendance.Clients",
    "ExpireMinutes": 60
  },
  "DeviceAuth": {
    "ApiKey": "netface-terminal-default-api-key"
  },
  "OnnxModels": {
    "YuNetModelPath": "assets/models/yunet.onnx",
    "SFaceModelPath": "assets/models/sface.onnx"
  },
  "FaceMatching": {
    "MatchThreshold": 0.50
  }
}
